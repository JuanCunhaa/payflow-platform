generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  name         String
  slug         String       @unique
  schoolCode   String       @unique @map("school_code")
  status       TenantStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  id           String       @id @default(uuid()) @db.Uuid
  settingsJson Json?        @map("settings_json")
  classes      Class[]
  contracts    Contract[]
  grades       Grade[]
  guardians    Guardian[]
  invoices     Invoice[]
  memberships  Membership[]
  students     Student[]
  tickets      Ticket[]

  @@map("tenants")
}

model User {
  email               String               @unique @db.Citext
  name                String?
  createdAt           DateTime             @default(now()) @map("created_at")
  emailVerified       Boolean              @default(false) @map("email_verified")
  status              UserStatus           @default(PENDING_APPROVAL)
  type                UserType             @default(GUARDIAN)
  updatedAt           DateTime             @updatedAt @map("updated_at")
  passwordHash        String               @map("password_hash")
  id                  String               @id @default(uuid()) @db.Uuid
  createdContracts    Contract[]           @relation("UserCreatedContracts")
  emailVerifyTokens   EmailVerifyToken[]
  guardians           Guardian[]
  memberships         Membership[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  ticketMessages      TicketMessage[]
  assignedTickets     Ticket[]             @relation("UserAssignedTickets")
  createdTickets      Ticket[]             @relation("UserCreatedTickets")

  @@map("users")
}

model Membership {
  role      Role     @default(GUARDIAN)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@map("memberships")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  actorUserId String?   @map("actor_user_id") @db.Uuid
  actorType   ActorType @map("actor_type")
  action      String
  targetType  String?   @map("target_type")
  targetId    String?   @map("target_id")
  metadata    Json?
  ip          String?   @map("ip")
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model Lead {
  id         String     @id @default(uuid()) @db.Uuid
  name       String
  schoolName String     @map("school_name")
  email      String
  phone      String
  status     LeadStatus @default(NEW)
  createdAt  DateTime   @default(now()) @map("created_at")

  @@map("leads")
}

model Grade {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  classes   Class[]
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("grades")
}

model Class {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  gradeId   String    @map("grade_id") @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  grade     Grade     @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students  Student[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([gradeId])
  @@map("classes")
}

model Student {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  classId   String?           @map("class_id") @db.Uuid
  name      String
  status    StudentStatus     @default(ACTIVE)
  birthDate DateTime?         @map("birth_date")
  createdAt DateTime          @default(now()) @map("created_at")
  contractStudents ContractStudent[]
  guardians        GuardianStudent[]
  invoices         Invoice[]
  class            Class?            @relation(fields: [classId], references: [id], onDelete: Cascade)
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, classId, name])
  @@index([tenantId])
  @@index([classId])
  @@map("students")
}

model Guardian {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  name      String
  phone     String
  cpf       String?
  rg        String?
  address   Json?
  status    GuardianStatus    @default(ACTIVE)
  createdAt DateTime          @default(now()) @map("created_at")
  students  GuardianStudent[]
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices  Invoice[]

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("guardians")
}

model GuardianStudent {
  id         String   @id @default(uuid()) @db.Uuid
  guardianId String   @map("guardian_id") @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([guardianId, studentId])
  @@index([guardianId])
  @@index([studentId])
  @@map("guardian_students")
}

model EmailVerifyToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verify_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Contract {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  name             String
  amountCents      Int               @map("amount_cents")
  currency         String            @default("BRL")
  dueDay           Int               @map("due_day")
  startDate        DateTime          @map("start_date")
  endDate          DateTime?         @map("end_date")
  status           ContractStatus    @default(ACTIVE)
  createdByUserId  String            @map("created_by_user_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at")
  contractStudents ContractStudent[]
  createdByUser    User              @relation("UserCreatedContracts", fields: [createdByUserId], references: [id], onDelete: Cascade)
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices         Invoice[]

  @@index([tenantId])
  @@map("contracts")
}

model ContractStudent {
  id         String   @id @default(uuid()) @db.Uuid
  contractId String   @map("contract_id") @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([contractId, studentId])
  @@index([studentId])
  @@map("contract_students")
}

model Invoice {
  id                 String                 @id @default(uuid()) @db.Uuid
  tenantId           String                 @map("tenant_id") @db.Uuid
  contractId         String?                @map("contract_id") @db.Uuid
  guardianId         String?                @map("guardian_id") @db.Uuid
  studentId          String?                @map("student_id") @db.Uuid
  amountCents        Int                    @map("amount_cents")
  dueDate            DateTime               @map("due_date")
  status             InvoiceStatus          @default(DRAFT)
  provider           InvoiceProvider        @default(SANDBOX)
  providerReference  String?                @map("provider_reference")
  createdAt          DateTime               @default(now()) @map("created_at")
  paymentLink        String?                @map("payment_link")
  paidAt             DateTime?              @map("paid_at")
  paidMethod         InvoicePaidMethod?     @map("paid_method")
  paidNote           String?                @map("paid_note")
  receiptUrl         String?                @map("receipt_url")
  competenceYear     Int                    @map("competence_year")
  competenceMonth    Int                    @map("competence_month")
  lastReminderSentAt DateTime?              @map("last_reminder_sent_at")
  communications     InvoiceCommunication[]
  items              InvoiceItem[]
  contract           Contract?              @relation(fields: [contractId], references: [id])
  guardian           Guardian?              @relation(fields: [guardianId], references: [id])
  student            Student?               @relation(fields: [studentId], references: [id])
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, contractId, competenceYear, competenceMonth], map: "invoices_tenant_contract_competence_key")
  @@index([tenantId])
  @@index([contractId])
  @@index([guardianId])
  @@index([studentId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  description String
  amountCents Int     @map("amount_cents")
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model InvoiceCommunication {
  id        String                   @id @default(uuid()) @db.Uuid
  invoiceId String                   @map("invoice_id") @db.Uuid
  type      InvoiceCommunicationType @map("type")
  sentAt    DateTime                 @default(now()) @map("sent_at")
  invoice   Invoice                  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([invoiceId, type, sentAt], map: "invoice_communications_invoice_type_sent_at_idx")
  @@map("invoice_communications")
}

model Ticket {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String?         @map("tenant_id") @db.Uuid
  createdById    String?         @map("created_by_id") @db.Uuid
  assignedToId   String?         @map("assigned_to_id") @db.Uuid
  subject        String
  status         TicketStatus    @default(OPEN)
  priority       TicketPriority  @default(MEDIUM)
  type           TicketType      @default(GENERAL)
  guestName      String?         @map("guest_name")
  guestEmail     String?         @map("guest_email")
  escalatedToPid Boolean         @default(false) @map("escalated_to_pid")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  closedAt       DateTime?       @map("closed_at")
  messages       TicketMessage[]
  assignedTo     User?           @relation("UserAssignedTickets", fields: [assignedToId], references: [id])
  createdBy      User?           @relation("UserCreatedTickets", fields: [createdById], references: [id])
  tenant         Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([status])
  @@map("tickets")
}

model TicketMessage {
  id         String    @id @default(uuid()) @db.Uuid
  ticketId   String    @map("ticket_id") @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  message    String
  isInternal Boolean   @default(false) @map("is_internal")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  ticket     Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@map("ticket_messages")
}

enum TenantStatus {
  ACTIVE
  DRAFT
  SUSPENDED
}

enum UserType {
  PLATFORM
  STAFF
  GUARDIAN
}

enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
}

enum Role {
  PLATFORM_ADMIN
  SCHOOL_ADMIN
  GUARDIAN
  STAFF
  PLATFORM_SUPPORT
  FINANCE
  SECRETARY
  READONLY
}

enum ActorType {
  SYSTEM
  USER
  PUBLIC
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum GuardianStatus {
  ACTIVE
  INACTIVE
}

enum ContractStatus {
  ACTIVE
  PAUSED
  CANCELED
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  CANCELED
  REFUNDED
}

enum InvoiceProvider {
  SANDBOX
  MERCADOPAGO
}

enum InvoicePaidMethod {
  MANUAL
  SANDBOX
}

enum InvoiceCommunicationType {
  CREATED
  OVERDUE
  PAID
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketType {
  GENERAL
  FINANCIAL
  ACADEMIC
  TECHNICAL
  OTHER
}
