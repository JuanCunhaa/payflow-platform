// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============

enum TenantStatus {
  ACTIVE
  DRAFT
  SUSPENDED
}

enum UserType {
  PLATFORM
  STAFF
  GUARDIAN
}

enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
}

enum Role {
  PLATFORM_ADMIN
  PLATFORM_SUPPORT
  SCHOOL_ADMIN
  FINANCE
  SECRETARY
  READONLY
  GUARDIAN
  STAFF
}

// ============ MODELS ============

model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String       @unique
  schoolCode  String       @unique @map("school_code")
  status      TenantStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  memberships Membership[]

  @@map("tenants")
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique @db.Citext
  name          String?
  passwordHash  String     @map("password_hash")
  type          UserType   @default(GUARDIAN)
  status        UserStatus @default(PENDING_APPROVAL)
  emailVerified Boolean    @default(false) @map("email_verified")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  memberships   Membership[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  role      Role     @default(GUARDIAN)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId   String @db.Uuid @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String @db.Uuid @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@map("memberships")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  userId String @db.Uuid @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "refresh_tokens_user_id_idx")
  @@index([expiresAt], map: "refresh_tokens_expires_at_idx")
  @@map("refresh_tokens")
}
