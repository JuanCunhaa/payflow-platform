// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============

enum TenantStatus {
  ACTIVE
  DRAFT
  SUSPENDED
}

enum UserType {
  PLATFORM
  STAFF
  GUARDIAN
}

enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
}

enum Role {
  PLATFORM_ADMIN
  PLATFORM_SUPPORT
  SCHOOL_ADMIN
  FINANCE
  SECRETARY
  READONLY
  GUARDIAN
  STAFF
}

enum ActorType {
  SYSTEM
  USER
  PUBLIC
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
}

// ============ MODELS ============

model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String       @unique
  schoolCode  String       @unique @map("school_code")
  status      TenantStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  settingsJson Json?       @map("settings_json")

  memberships Membership[]
  grades      Grade[]
  classes     Class[]

  @@map("tenants")
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique @db.Citext
  name          String?
  passwordHash  String     @map("password_hash")
  type          UserType   @default(GUARDIAN)
  status        UserStatus @default(PENDING_APPROVAL)
  emailVerified Boolean    @default(false) @map("email_verified")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  memberships   Membership[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  role      Role     @default(GUARDIAN)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId   String @db.Uuid @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String @db.Uuid @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@map("memberships")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  userId String @db.Uuid @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "refresh_tokens_user_id_idx")
  @@index([expiresAt], map: "refresh_tokens_expires_at_idx")
  @@map("refresh_tokens")
}

model AuditLog {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String?    @db.Uuid @map("tenant_id")
  actorUserId String?    @db.Uuid @map("actor_user_id")
  actorType   ActorType  @map("actor_type")
  action      String
  targetType  String?    @map("target_type")
  targetId    String?    @map("target_id")
  metadata    Json?
  ip          String?    @map("ip")
  userAgent   String?    @map("user_agent")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([tenantId], map: "audit_logs_tenant_id_idx")
  @@index([actorUserId, createdAt], map: "audit_logs_actor_user_id_created_at_idx")
  @@map("audit_logs")
}

model Lead {
  id         String     @id @default(uuid()) @db.Uuid
  name       String
  schoolName String     @map("school_name")
  email      String
  phone      String
  status     LeadStatus @default(NEW)
  createdAt  DateTime   @default(now()) @map("created_at")

  @@map("leads")
}

model Grade {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  classes   Class[]

  @@unique([tenantId, name])
  @@index([tenantId], map: "grades_tenant_id_idx")
  @@map("grades")
}

model Class {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gradeId   String   @db.Uuid @map("grade_id")
  grade     Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, name])
  @@index([tenantId], map: "classes_tenant_id_idx")
  @@index([gradeId], map: "classes_grade_id_idx")
  @@map("classes")
}
