    "@nestjs/platform-express": "^11.1.12",
    "@nestjs/throttler": "^6.5.0",
    "@payflow/shared": "*",
    "@prisma/client": "^7.3.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^17.2.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
